{
  "identifier": "bob-plugin-openai-tts",
  "version": "1.6.0",
  "category": "tts",
  "name": "OpenAI TTS",
  "summary": "使用 OpenAI Realtime / Speech 或 OpenRouter 兼容 TTS API 进行语音合成。",
  "icon": "",
  "author": "poyih & Claude",
  "homepage": "https://github.com/poyih/bob-plugin-openai-tts",
  "appcast": "https://github.com/poyih/bob-plugin-openai-tts/raw/main/appcast.json",
  "minBobVersion": "1.8.0",
  "options": [
    {
      "identifier": "apiKey",
      "type": "text",
      "title": "API Key",
      "defaultValue": "",
      "textConfig": {
        "type": "secure",
        "placeholderText": "sk-..."
      }
    },
    {
      "identifier": "apiUrl",
      "type": "text",
      "title": "API URL",
      "defaultValue": "https://api.openai.com",
      "desc": "支持域名、/v1 基地址或完整接口地址。Realtime 模型自动使用 /v1/realtime 的 WSS 连接，也可填写完整 wss:// 地址；Speech 模型使用 /v1/audio/speech。OpenRouter 可填写 https://openrouter.ai 或完整 /api/v1/audio/speech 地址。远程服务默认要求 HTTPS/WSS。",
      "textConfig": {
        "type": "visible",
        "placeholderText": "https://api.openai.com"
      }
    },
    {
      "identifier": "allowInsecureHttp",
      "type": "menu",
      "title": "Allow insecure remote HTTP",
      "desc": "危险选项。仅在必须连接不支持 HTTPS/WSS 的远程兼容服务时开启；HTTP/WS 会使 API Key 和文本以明文传输。本机 localhost/127.0.0.0/8/[::1] 无需开启。",
      "defaultValue": "false",
      "menuValues": [
        { "title": "No (recommended)", "value": "false" },
        { "title": "Yes, I understand the risk", "value": "true" }
      ]
    },
    {
      "identifier": "model",
      "type": "menu",
      "title": "Model",
      "desc": "新安装默认使用 gpt-realtime-2.1-mini，经 WebSocket 合成并输出 WAV。OpenAI 已公告旧 tts-1、tts-1-hd 和 mini-tts 快照于 2027-01-06 停服，请提前迁移；已有保存配置不会自动切换。OpenRouter 请使用 Custom Model ID。",
      "defaultValue": "gpt-realtime-2.1-mini",
      "menuValues": [
        { "title": "gpt-realtime-2.1-mini (recommended)", "value": "gpt-realtime-2.1-mini" },
        { "title": "gpt-realtime-2.1", "value": "gpt-realtime-2.1" },
        { "title": "tts-1 (OpenAI ends 2027-01-06)", "value": "tts-1" },
        { "title": "tts-1-hd (OpenAI ends 2027-01-06)", "value": "tts-1-hd" },
        { "title": "gpt-4o-mini-tts (deprecated)", "value": "gpt-4o-mini-tts" },
        { "title": "gpt-4o-mini-tts-2025-12-15 (OpenAI ends 2027-01-06)", "value": "gpt-4o-mini-tts-2025-12-15" },
        { "title": "Custom Model ID", "value": "custom" }
      ]
    },
    {
      "identifier": "customModel",
      "type": "text",
      "title": "Custom Model ID",
      "defaultValue": "",
      "desc": "可选。填写后覆盖 Model 预设。迁移到 Realtime 时请清空旧的自定义模型值。OpenRouter 请填写当前模型列表中的完整 ID，例如 mistralai/voxtral-mini-tts-2603；不同模型需要匹配各自的音色和格式。",
      "textConfig": {
        "type": "visible",
        "placeholderText": "mistralai/voxtral-mini-tts-2603"
      }
    },
    {
      "identifier": "voiceRealtime",
      "type": "menu",
      "title": "Voice (Realtime)",
      "desc": "用于 gpt-realtime-2.1 / mini 系列。marin 和 cedar 为推荐音色；Custom Voice ID 可覆盖此选项。",
      "defaultValue": "marin",
      "menuValues": [
        { "title": "alloy", "value": "alloy" },
        { "title": "ash", "value": "ash" },
        { "title": "ballad", "value": "ballad" },
        { "title": "cedar (recommended)", "value": "cedar" },
        { "title": "coral", "value": "coral" },
        { "title": "echo", "value": "echo" },
        { "title": "marin (recommended)", "value": "marin" },
        { "title": "sage", "value": "sage" },
        { "title": "shimmer", "value": "shimmer" },
        { "title": "verse", "value": "verse" }
      ]
    },
    {
      "identifier": "voice",
      "type": "menu",
      "title": "Voice (tts-1 / tts-1-hd)",
      "desc": "Used when Model is tts-1 or tts-1-hd. Custom Voice ID below overrides this selection.",
      "defaultValue": "alloy",
      "menuValues": [
        { "title": "alloy", "value": "alloy" },
        { "title": "ash", "value": "ash" },
        { "title": "coral", "value": "coral" },
        { "title": "echo", "value": "echo" },
        { "title": "fable", "value": "fable" },
        { "title": "onyx", "value": "onyx" },
        { "title": "nova", "value": "nova" },
        { "title": "sage", "value": "sage" },
        { "title": "shimmer", "value": "shimmer" }
      ]
    },
    {
      "identifier": "voiceMini",
      "type": "menu",
      "title": "Voice (gpt-4o-mini-tts family)",
      "desc": "Used when Model is any gpt-4o-mini-tts snapshot, including OpenRouter IDs. Custom Voice ID below overrides this selection.",
      "defaultValue": "marin",
      "menuValues": [
        { "title": "alloy", "value": "alloy" },
        { "title": "ash", "value": "ash" },
        { "title": "ballad", "value": "ballad" },
        { "title": "cedar (recommended)", "value": "cedar" },
        { "title": "coral", "value": "coral" },
        { "title": "echo", "value": "echo" },
        { "title": "fable", "value": "fable" },
        { "title": "marin (recommended)", "value": "marin" },
        { "title": "onyx", "value": "onyx" },
        { "title": "nova", "value": "nova" },
        { "title": "sage", "value": "sage" },
        { "title": "shimmer", "value": "shimmer" },
        { "title": "verse", "value": "verse" }
      ]
    },
    {
      "identifier": "customVoice",
      "type": "text",
      "title": "Custom Voice ID",
      "defaultValue": "",
      "desc": "可选。覆盖上方 Voice 预设。非 OpenRouter 地址下，voice_... ID 会作为 OpenAI voice 对象发送（需具备相应资格）；OpenRouter 地址下始终按模型支持的音色字符串发送。",
      "textConfig": {
        "type": "visible",
        "placeholderText": "voice_123abc or en_paul_neutral"
      }
    },
    {
      "identifier": "speed",
      "type": "menu",
      "title": "Speed",
      "desc": "Realtime 支持 0.25x–1.5x；tts-1 / tts-1-hd 支持 0.25x–4.0x。mini-tts 系列请使用 Instructions 控制语速；未知模型不发送未经确认支持的 speed 参数。",
      "defaultValue": "1.0",
      "menuValues": [
        { "title": "0.25x", "value": "0.25" },
        { "title": "0.5x", "value": "0.5" },
        { "title": "0.75x", "value": "0.75" },
        { "title": "1.0x (default)", "value": "1.0" },
        { "title": "1.25x", "value": "1.25" },
        { "title": "1.5x", "value": "1.5" },
        { "title": "2.0x", "value": "2.0" },
        { "title": "3.0x", "value": "3.0" },
        { "title": "4.0x", "value": "4.0" }
      ]
    },
    {
      "identifier": "responseFormat",
      "type": "menu",
      "title": "Audio Format",
      "desc": "Realtime 固定输出 24 kHz 单声道 WAV，此选项仅用于 Speech 模型。OpenAI Speech 支持全部六种格式；OpenRouter 接受 MP3/PCM（Voxtral 使用 MP3）。PCM 根据响应采样率和声道元数据封装为 WAV；未知元数据时请改用 MP3。",
      "defaultValue": "mp3",
      "menuValues": [
        { "title": "MP3 (default)", "value": "mp3" },
        { "title": "AAC", "value": "aac" },
        { "title": "OPUS", "value": "opus" },
        { "title": "FLAC", "value": "flac" },
        { "title": "WAV", "value": "wav" },
        { "title": "PCM", "value": "pcm" }
      ]
    },
    {
      "identifier": "instructions",
      "type": "text",
      "title": "Instructions",
      "defaultValue": "",
      "desc": "用于 Realtime 和 gpt-4o-mini-tts 系列，最多 4096 个 Unicode 字符。仅设置朗读风格、语气和情感。mini-tts 的文本与 Instructions 还须满足合计 2000 token 的保守预算。",
      "textConfig": {
        "type": "visible",
        "height": 80,
        "placeholderText": "Speak warmly, clearly, and at a relaxed pace."
      }
    }
  ]
}
